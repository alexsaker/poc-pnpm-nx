{
  "name": "api",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/api", "command": "pnpm run dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/api", "command": "pnpm run build" },
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/api", "command": "pnpm run test" },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/api", "command": "pnpm run lint" },
      "dependsOn": ["build"]
    }
  }
}