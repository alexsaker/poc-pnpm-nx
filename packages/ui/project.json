{
  "name": "ui",
  "sourceRoot": "packages/ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm run build" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm run test" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm run lint" }
    }
  }
}
